# Google Gemini API Key (Required for LLM answer generation)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Gemini Model Identifier
# Supported options: gemini-2.5-flash, gemini-1.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Generation Temperature (0.0 for deterministic, factual grounding)
TEMPERATURE=0.0

# Embedding Model (Local Sentence Transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Persistent ChromaDB Directory & Collection
CHROMA_DIR=./chroma_db
COLLECTION_NAME=designs_manual

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval Configuration
TOP_K=5
RELEVANCE_THRESHOLD=0.50

# Source PDF Configuration
PDF_PATH=data/raw/designs_manual.pdf
PDF_URL=https://ipindia.gov.in/storage/uploads/docs-operator/1ebf65d0-3b78-499a-a9a8-ba28863962f2.pdf
